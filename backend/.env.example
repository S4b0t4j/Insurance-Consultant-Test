# API Keys Configuration
# Copy this file to .env and fill in your API keys

# Anthropic Claude API Key (Required)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API Key (Required for Whisper transcription)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ElevenLabs API Key (Optional - for podcast generation)
# Get your key at: https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Unsplash API Key (Optional - for PowerPoint images)
# Get your key at: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# Server Configuration
PORT=3001
